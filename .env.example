# Environment variable template for spring2shell
# Copy to .env and fill in values. NEVER commit .env to version control.

# ── TLS / Network ──────────────────────────────────────────────────────────────
# Set to "true" to disable TLS certificate verification (NOT recommended)
SPRING2SHELL_INSECURE=false

# ── Logging ────────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
SPRING2SHELL_LOG_LEVEL=INFO

# Set to "true" to log swallowed network exceptions for diagnostics
SPRING2SHELL_VERBOSE_ERRORS=false

# ── Output ─────────────────────────────────────────────────────────────────────
# Default directory for scan reports
SPRING2SHELL_REPORT_DIR=reports

# ── Concurrency ────────────────────────────────────────────────────────────────
# Max worker threads for concurrent endpoint probing
SPRING2SHELL_MAX_WORKERS=10

# ── Config ─────────────────────────────────────────────────────────────────────
# Override default config file path
SPRING2SHELL_CONFIG=configs/default.yaml
